<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required for notarization with the hardened runtime. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- whisper.cpp JITs on some backends; drop this if the chosen backend
         does not need it, since it weakens the hardened runtime. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
</dict>
</plist>
